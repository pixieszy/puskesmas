	<queryString language="SQL">
		<![CDATA[SELECT
     rekam_medis.`id_rekam` AS rekam_medis_id_rekam,
     rekam_medis.`id_pasien` AS rekam_medis_id_pasien,
     rekam_medis.`id_dokter` AS rekam_medis_id_dokter,
     rekam_medis.`id_poli` AS rekam_medis_id_poli,
     rekam_medis.`keluhan` AS rekam_medis_keluhan,
     rekam_medis.`diagnosa` AS rekam_medis_diagnosa,
     rekam_medis.`tindakan` AS rekam_medis_tindakan,
     rekam_medis.`catatan_dokter` AS rekam_medis_catatan_dokter,
     rekam_medis.`resep` AS rekam_medis_resep,
     rekam_medis.`tanggal_kunjungan` AS rekam_medis_tanggal_kunjungan
FROM
     `rekam_medis` rekam_medis]]>
	</queryString>
