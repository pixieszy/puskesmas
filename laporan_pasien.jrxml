	<queryString language="SQL">
		<![CDATA[SELECT
     pasien.`id_pasien` AS pasien_id_pasien,
     pasien.`nama_pasien` AS pasien_nama_pasien,
     pasien.`nik` AS pasien_nik,
     pasien.`no_bpjs` AS pasien_no_bpjs,
     pasien.`jenis_kelamin` AS pasien_jenis_kelamin,
     pasien.`tanggal_lahir` AS pasien_tanggal_lahir,
     pasien.`no_telepon` AS pasien_no_telepon,
     pasien.`alamat` AS pasien_alamat
FROM
     `pasien` pasien]]>
	</queryString>
