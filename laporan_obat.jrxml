	<queryString language="SQL">
		<![CDATA[SELECT
     obat.`id_obat` AS obat_id_obat,
     obat.`nama_obat` AS obat_nama_obat,
     obat.`kategori` AS obat_kategori,
     obat.`jenis` AS obat_jenis,
     obat.`stok` AS obat_stok,
     obat.`harga` AS obat_harga,
     obat.`brand` AS obat_brand,
     obat.`bpjs_status` AS obat_bpjs_status,
     obat.`nip` AS obat_nip,
     obat.`input_date` AS obat_input_date,
     obat.`edit_date` AS obat_edit_date
FROM
     `obat` obat]]>
	</queryString>
